PUNUSER=""

for ((i = 1; i <= $#; i++)); do
  arg="${!i}"

  # Check if the argument is "-u" followed by a username
  if [[ "$arg" == "-u" ]]; then
    next_index=$((i + 1))
    PUNUSER="${!next_index}"
    break
  fi
done

if [ -n "$PUNUSER" ]; then
    logger -- "Setting the VSC variables for $PUNUSER"

    if [ -d "${VSC_DATA}" ]; then
        export OOD_DATAROOT=${VSC_DATA}/.ondemand/${VSC_INSTITUTE_CLUSTER:-data}/
    else
        export OOD_DATAROOT="${VSC_SCRATCH}/.ondemand/${VSC_INSTITUTE_CLUSTER:-data}/"
        logger -- "VSC_DATA unavailable for $PUNUSER, using home: $OOD_DATAROOT"
    fi

    runuser -u "${PUNUSER}" bash /etc/profile.d/vscautokey.sh &
fi
