echo $$ > "$OOD_SESSION_STAGED_ROOT/ns.pid"

# Wait for slirp4netns to actually finish configuring the network interface (bounded to ~15s)
SECONDS=0
while [ ! -s "$OOD_SESSION_STAGED_ROOT/slirp_ready" ] && [ "$SECONDS" -lt 15 ]; do sleep .5; done
[ -s "$OOD_SESSION_STAGED_ROOT/slirp_ready" ] || echo "WARNING: timed out waiting for network readiness signal from slirp4netns, proceeding anyway"

ollama serve > "$OOD_SESSION_STAGED_ROOT/ollama.log" 2>&1 &
code tunnel --accept-server-license-terms --name "vsc-$USER-$VSC_INSTITUTE_CLUSTER"
