#!/bin/bash
<% is_sofia = OodAppkit.clusters.any? { |c| c.id.to_s == "sofia" } %>
DATA_DIR="<%= is_sofia ? '$HOME' : '$VSC_DATA' %>"

# Make symlinks for ~/.vscode and ~/.vscode-server
for dir in .vscode .vscode-server; do
    if [[ ! -e ~/"$dir" ]]; then
        mkdir -v -p "$DATA_DIR/$dir"
<% unless is_sofia %>
        ln -v -s "$DATA_DIR/$dir" ~/"$dir" # already at $HOME on sofia
<% end %>
    fi
done

modules_to_load=("code-cli")

<% unless is_sofia %>
<%
  ollama_versions = YAML.load(ERB.new(File.read(session.app.root.join("ollama_versions.yml.erb")), eoutvar: "@ollama_versions_erb").result(binding))
  ollama_module = ollama_versions.find { |v| v['version'] == context.ollama_version.to_s }
%>
if (( USE_OLLAMA )); then
<% if ollama_module %>
    modules_to_load+=("<%= ollama_module['module'] %>")
<% else %>
    echo "ERROR: Unsupported Ollama version selected: <%= context.ollama_version %>"
    exit 1
<% end %>
fi
<% end %>

echo "Modules to load: ${modules_to_load[*]}"
module load "${modules_to_load[@]}"

OOD_CONTEXT_CLEANUP_LOGIN=<%= context.advanced_cleanup_login %>

if [[ "$OOD_CONTEXT_CLEANUP_LOGIN" -eq 1 ]]; then
    tokfn=~/.vscode/cli/token.json
    echo "Cleaning up local token file $tokfn"
    rm -f "$tokfn"
fi

# Merge custom confi with bundled config
confdir=$(dirname "$TCONF_BUNDLE")

export TCONF="$confdir/custom_final.conf"

custom="$confdir/custom.conf"
cat > "$custom"<<EOF
new-session -d -s $TSES
set -g status off #NOTE: this will disable the status bar (green text in the bottom)
pipe-pane -o -t $TSES 'cat >> $OOD_SESSION_STAGED_ROOT/tunnel_session.log'
EOF

while IFS=$'\n' read -r line; do
    [ -z "$line" ] && continue
    if [ "$line" == "reset" ]; then
        export TMUX_WAITFOR=CUSTOMCHANNEL
        # must release the lock from within, so must be run as command in shell
        # so not : echo "wait-for -S $TMUX_WAITFOR" >> $custom
        echo "send-keys -t $TSES \"tmux -S $TSOCK wait-for -S $TMUX_WAITFOR\" C-m" >> "$custom"
    fi
    cmd=${line//\"/\\\"}
    echo "send-keys -t $TSES \"$cmd\" C-m" >> "$custom"
done < "$confdir/custom_commands.conf"

cat "$TCONF_BUNDLE" "$custom" > "$TCONF"
