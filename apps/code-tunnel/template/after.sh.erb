<%= ERB.new(File.read('../common_files/wait_server_start.sh.erb'), eoutvar: 'child').result(binding) %>

# wait for tmux socket and optional release of wait-for
"$OOD_SESSION_STAGED_ROOT/waitfor_tmux.sh"

if (( USE_OLLAMA && !OLLAMA_GPU_MISSING )); then

  # Wait until unshare has written its pid to ns.pid (bounded to ~15s)
  SECONDS=0
  while [ ! -s "$OOD_SESSION_STAGED_ROOT/ns.pid" ] && [ "$SECONDS" -lt 15 ]; do sleep .5; done
  [ -s "$OOD_SESSION_STAGED_ROOT/ns.pid" ] || echo "WARNING: timed out waiting for unshare, proceeding anyway"
  UNSHARE_PID="$(< "$OOD_SESSION_STAGED_ROOT/ns.pid")"

  echo "Starting network interface"

  # This creates a tap0 device in the network namespace and provides a socket to configure.
  # --ready-fd writes to this file once the interface is actually configured
  slirp4netns \
    --configure \
    --ready-fd=3 \
    --api-socket "$SLIRP_SOCKET" \
    "$UNSHARE_PID" \
    tap0 3>"$OOD_SESSION_STAGED_ROOT/slirp_ready" &> "$OOD_SESSION_STAGED_ROOT/network.log" &
fi

