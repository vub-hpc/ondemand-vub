#!/usr/bin/bash -l

<% is_sofia = OodAppkit.clusters.any? { |c| c.id.to_s == "sofia" } %>

<%= ERB.new(File.read('../common_files/work_directory_change.sh.erb'), eoutvar: 'child').result(binding) %>

# Benchmark info
echo "TIMING - Starting main script at: $(date)"

TOOLCHAIN=<%= context.toolchain %>

modules_to_load=()

case "${TOOLCHAIN}" in
<% unless is_sofia %>
  2023a )
    modules_to_load+=("ParaView/5.11.2-foss-2023a")
    ;;
  2024a )
    modules_to_load+=("ParaView/5.13.2-foss-2024a")
    ;;
<% end %>
  2025a )
    modules_to_load+=("ParaView/6.0.1-foss-2025a")
    ;;
  * )
    echo "ERROR: Unsupported toolchain selected"
    exit 1
    ;;
esac

<%- unless context.global_prerun.empty? -%>
<%= context.global_prerun.gsub("\r", "") %>
<%- end -%>

cat > "$OOD_SESSION_STAGED_ROOT/autostart.sh" <<EOF
bash -c 'echo Starting ParaView ... && module load ${modules_to_load[@]} && vglrun paraview'
EOF

<%= ERB.new(File.read('../common_files/desktops/desktop_launch.sh.erb'), eoutvar: 'child').result(binding) %>
