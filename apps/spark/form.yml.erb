<% is_bigdata_manager = `id -nG`.split.include?('bbigdatamanagers') %>
---
attributes:
  advanced_font_size: 16
  advanced_tmux_config: "1"
  global_prerun: ""
  cluster:
    value: "gulon"
    fixed: true
  jar_path:
    widget: "path_selector"
    label: "Jar file"
    help: "Upload your jar via the Files app first, then select it here."
    show_files: true
    file_pattern: "\\.jar$"
  dataset:
    widget: "select"
    label: "Dataset"
    options:
      - ["otto-tiny", "/databases/bigdataprocessing/otto-tiny.jsonl"]
      - ["otto-local", "/databases/bigdataprocessing/otto-local.jsonl"]
      - ["otto-full", "/databases/bigdataprocessing/otto-full.jsonl"]
<% if is_bigdata_manager %>
      - ["otto-tiny dummy (visible to bbigdatamanagers only)", "/databases/bigdataprocessing/otto-tiny.jsonl"]
<% end %>

  main_class:
    widget: "text_field"
    label: "Main class"
    placeholder: "example.Hello"

form:
  - cluster
  - jar_path
  - dataset
  - main_class
  - advanced_font_size
  - advanced_tmux_config
  - global_prerun
